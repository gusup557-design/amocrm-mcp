# amoCRM connects through OAuth at /connect; do not configure legacy static tokens.
AMOCRM_REDIRECT_URI=https://amocrm-mcp-ascan-006.vercel.app/oauth/callback

# Supabase server-side OAuth persistence (never expose in client applications).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
MCP_TOKEN_ENCRYPTION_KEY=
MCP_ADMIN_PASSWORD=

# CRM and chat writes remain disabled until deliberately enabled.
MCP_ALLOW_WRITE=false

# amoCRM Chat API (requires a channel registered by amoCRM support).
AMOCHAT_BASE_URL=https://amojo.amocrm.ru
AMOCHAT_SCOPE_ID=
AMOCHAT_CHANNEL_SECRET=
AMOCHAT_BOT_CLIENT_ID=
AMOCHAT_BOT_REF_ID=
AMOCHAT_BOT_NAME=

# ElevenLabs Scribe v2 transcription (paid usage is separately guarded).
ELEVENLABS_API_KEY=
TRANSCRIPTION_ALLOWED_HOSTS=
MCP_ALLOW_PAID_AI=false

# ElevenLabs voice agent and SIP phone number (no call starts unless all guards pass).
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
MCP_ALLOW_OUTBOUND_CALLS=false
VOICE_CALL_ALLOWED_NUMBERS=

# Signed webhook ingestion (store secrets server-side only).
ELEVENLABS_WEBHOOK_SECRET=
